#!/bin/sh
# Project C code compiles warning-free under strict flags (roadmap Stage 1).
# The check first compiles a planted warning and requires it to fail, since
# -fsyntax-only alone exits 0 on warnings: a gate is trusted once it has been
# seen to fail. Run from the package root.
set -eu

CC=${CC:-cc}
RINC=$(Rscript -e 'cat(R.home("include"))')
ZUFAST=$(Rscript -e 'cat(system.file("include", package = "zufast"))')
FLAGS="-std=gnu99 -DNDEBUG -Wall -Wextra -Wpedantic -Wshadow -Wstrict-prototypes -Werror -fsyntax-only"
# R's and zufast's headers are -isystem: the gate is for zudedup's code. R
# 4.6's R_ext/Boolean.h uses a C23 enum form that -Wpedantic rejects.
INC="-isystem $RINC -isystem $ZUFAST -Isrc"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

printf 'int zdd_lint_canary(void) { int unused; return 0; }\n' > "$WORK/canary.c"
if $CC $FLAGS "$WORK/canary.c" 2>/dev/null; then
  echo "FAIL: the lint gate accepted a planted warning" >&2
  exit 2
fi

fail=0
for f in src/*.c; do
  extra=""
  # init.c casts each entry point to DL_FUNC, the registration idiom Writing R
  # Extensions prescribes; -Wextra's function-cast check rejects it by design.
  [ "$f" = src/init.c ] && extra="-Wno-cast-function-type"
  $CC $FLAGS $extra $INC "$f" || fail=1
done
# The R-free build of the chunker, as the fuzzer compiles it.
for f in src/zdd_cdc.c fuzz/*.c; do
  $CC $FLAGS -DZDD_STANDALONE -Isrc "$f" || fail=1
done
[ $fail = 0 ] || { echo "FAIL: warnings in project C code" >&2; exit 1; }
echo "==> project C code is warning-free under $FLAGS"
